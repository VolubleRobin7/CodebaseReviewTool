<?xml version="1.0" encoding="utf-8"?>
<!--
  The package sources for this repository. The clear keeps feeds configured on a machine (user-level NuGet.Config) out
  of restores here, so the build is the same everywhere and an unreachable machine-level feed cannot fail it.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
