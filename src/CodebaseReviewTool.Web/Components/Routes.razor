<Router AppAssembly="typeof(Routes).Assembly"
        NotFoundPage="typeof(Pages.NotFound)">

    <Found Context="routeData">
        <RouteView DefaultLayout="typeof(Layout.MainLayout)"
                   RouteData="routeData" />

        <FocusOnNavigate RouteData="routeData"
                         Selector="h1" />
    </Found>

</Router>
