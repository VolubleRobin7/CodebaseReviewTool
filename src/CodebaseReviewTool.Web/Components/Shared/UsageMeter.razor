@using System.Globalization
@using CodebaseReviewTool.Application.Common.Models
@using CodebaseReviewTool.Application.Usage

@implements IDisposable

@inject AgentUsageService Usage

@*
    One meter per agent, showing its limit closest to running out; the tooltip lists them all. An agent renders nothing
    when it has no limits (Claude Code on an API key).
*@
@foreach (var reading in Usage.Readings)
{
    var several = Usage.Readings.Count > 1;

    if (reading.Highest is { } limit)
    {
        var percent = (int)Math.Round(limit.PercentUsed, MidpointRounding.AwayFromZero);
        var label = several ? $"{reading.DisplayName}: {limit.Name}" : limit.Name;

        <div class="@($"usage-meter {LevelClass(percent)}")" title="@Tooltip(reading)">
            <span class="usage-label">@label</span>

            <span aria-label="@label"
                  aria-valuemax="100"
                  aria-valuemin="0"
                  aria-valuenow="@percent"
                  class="usage-track"
                  role="progressbar">

                <span class="usage-fill" style="@($"width: {percent.ToString(CultureInfo.InvariantCulture)}%")"></span>

            </span>

            <span class="usage-value">@percent%</span>

            @if (limit.ResetsAt is { } resetsAt)
            {
                <span class="usage-reset">resets @FormatReset(resetsAt)</span>
            }
        </div>
    }
    else if (reading.Limits is null && reading.LastError is { } error)
    {
        <div class="usage-meter usage-unavailable" title="@error">@(several ? $"{reading.DisplayName} usage unavailable" : "Usage unavailable")</div>
    }
    else if (reading.Limits is null)
    {
        <div class="usage-meter usage-unavailable">@(several ? $"Checking {reading.DisplayName} usage…" : "Checking usage…")</div>
    }
}

@code {
    protected override void OnInitialized() => Usage.Changed += OnUsageChanged;

    public void Dispose() => Usage.Changed -= OnUsageChanged;

    // The refresher raises Changed on its own thread; InvokeAsync moves the render onto this circuit's dispatcher.
    private void OnUsageChanged() => _ = InvokeAsync(StateHasChanged);

    private static string LevelClass(int percent) => percent switch
    {
        >= 90 => "usage-critical",
        >= 75 => "usage-warning",
        _ => string.Empty,
    };

    // "18 Nov, 7:30 pm" in this machine's time zone.
    private static string FormatReset(DateTime utc)
    {
        var local = DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
        return local.ToString("d MMM, h:mm ", CultureInfo.InvariantCulture) + (local.Hour < 12 ? "am" : "pm");
    }

    private string Tooltip(AgentUsageReading reading)
    {
        var lines = (reading.Limits ?? []).Select(l =>
            $"{l.Name}: {Math.Round(l.PercentUsed, MidpointRounding.AwayFromZero)}% used{(l.ResetsAt is { } at ? $", resets {FormatReset(at)}" : string.Empty)}");

        var checkedLine = reading.CheckedUtc is { } checkedUtc ? $"Checked {RelativeTime.Ago(checkedUtc)}" : "Not checked yet";
        if (reading.LastError is { } error)
        {
            checkedLine += $"; the latest check failed: {error}";
        }

        // With several agents the tooltip says whose limits these are.
        var heading = Usage.Readings.Count > 1 ? [reading.DisplayName] : Array.Empty<string>();
        return string.Join('\n', heading.Concat(lines).Append(checkedLine));
    }
}
