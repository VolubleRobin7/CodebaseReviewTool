<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared library for the service projects. References nothing.
    Processes\: starts command-line programs (Git and Agents).
    Configuration\: the placeholder check and path expansion every service project's options use.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

</Project>
