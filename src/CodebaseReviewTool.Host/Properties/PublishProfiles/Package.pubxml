<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the zip to give to someone else: dotnet publish src/CodebaseReviewTool.Host -p:PublishProfile=Package
  The same framework-dependent build as the Install profile, published under bin and then zipped to
  bin\Release\CodebaseReviewTool.zip with the shipped placeholder appsettings.json for the recipient to fill in.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <!-- The command line publishes to PublishDir and Visual Studio copies its output to PublishUrl, so both name the folder. -->
    <PackageDir>$(MSBuildProjectDirectory)\bin\Release\package\</PackageDir>
    <PublishDir>$(PackageDir)</PublishDir>
    <PublishUrl>$(PackageDir)</PublishUrl>
    <PackageZipPath>$(MSBuildProjectDirectory)\bin\Release\CodebaseReviewTool.zip</PackageZipPath>
  </PropertyGroup>
</Project>
