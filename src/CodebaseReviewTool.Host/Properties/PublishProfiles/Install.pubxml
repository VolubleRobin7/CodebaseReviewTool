<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes the tool to its install folder: dotnet publish src/CodebaseReviewTool.Host -p:PublishProfile=Install
  Framework-dependent, so the machine needs the .NET 10 runtime; the exe is then run from the folder below, and
  "Run at login" on the Configuration page points the Startup shortcut at it.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <!--
      The install folder, under the user's local application data. The command line publishes to PublishDir and
      Visual Studio copies its output to PublishUrl, so both name it.
    -->
    <InstallDir>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))\Programs\CodebaseReviewTool\</InstallDir>
    <PublishDir>$(InstallDir)</PublishDir>
    <PublishUrl>$(InstallDir)</PublishUrl>
    <!-- An update must not wipe the settings already filled in there. -->
    <KeepInstalledSettings>true</KeepInstalledSettings>
  </PropertyGroup>
</Project>
