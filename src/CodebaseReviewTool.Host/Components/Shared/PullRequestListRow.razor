@using CodebaseReviewTool.Core.Data.Enums

<div class="pr-row">
    <div class="pr-main">
        <div class="pr-title-line">
            <span class="pr-number">#@Item.PullRequest.Id</span>
            <span class="pr-title">@Item.PullRequest.Title</span>
            @if (Item.PullRequest.IsDraft)
            {
                <span class="tag">Draft</span>
            }
            @if (Item.PullRequest.MergeStatus == "conflicts")
            {
                <span class="tag tag-high">Conflicts</span>
            }
        </div>

        <div class="pr-meta">
            <span class="pr-meta-item">
                <span class="pr-meta-label">Repo</span>
                <span class="pr-meta-value">@Item.RepositoryName</span>
            </span>
            <span class="pr-meta-item">
                <span class="pr-meta-label">Author</span>
                <span class="pr-meta-value">@Item.PullRequest.AuthorName</span>
            </span>
            <span class="pr-meta-item">
                <span class="pr-meta-label">Branch</span>
                <span class="mono pr-meta-value">@Item.PullRequest.SourceBranch</span>
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <span class="pr-row-error">@Error</span>
        }
    </div>

    <div class="pr-actions">
        @switch (Item.State)
        {
            case null:
                <button @onclick="OnStart"
                        class="btn btn-primary"
                        disabled="@IsStarting"
                        type="button">

                    Start review

                </button>
                break;

            case ReviewState.Completed:
                <span class="pr-result">
                    <span>@Plural(Item.IssueCount, "issue")</span>
                    @if (Item.HighCount > 0)
                    {
                        <span class="pr-result-high">@Item.HighCount high</span>
                    }
                </span>

                <a class="btn btn-secondary"
                   href="reviews/@Item.LatestReview!.Id">

                    View report

                </a>

                @ReviewAgainButton
                break;

            case ReviewState.Cancelled:
                <a class="pr-cancelled"
                   href="reviews/@Item.LatestReview!.Id"
                   title="View what the cancelled review finished">

                    Review cancelled

                </a>

                @ReviewAgainButton
                break;

            case ReviewState.Failed:
                <a class="pr-failed"
                   href="reviews/@Item.LatestReview!.Id"
                   title="View the failed review">

                    Review failed

                </a>

                <button @onclick="OnStart"
                        class="btn btn-secondary"
                        disabled="@IsStarting"
                        type="button">

                    Retry

                </button>
                break;

            default:
                <span class="pr-status">
                    <a aria-label="Open the report so far"
                       class="pr-status-icon"
                       href="reviews/@Item.LatestReview!.Id"
                       title="Open the report so far">

                        <svg aria-hidden="true"
                             fill="none"
                             height="15"
                             stroke="currentColor"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             stroke-width="1.75"
                             viewBox="0 0 24 24"
                             width="15">

                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                            <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                            <path d="M16 13H8" />
                            <path d="M16 17H8" />

                        </svg>

                    </a>

                    <span class="@(Item.State == ReviewState.Queued ? "queued-dot" : "spinner")" />
                    <span>@StatusText</span>

                    <button @onclick="OnCancel"
                            aria-label="Stop review"
                            class="pr-status-icon pr-stop"
                            disabled="@IsCancelling"
                            title="Stop review"
                            type="button">

                        <svg aria-hidden="true"
                             height="15"
                             viewBox="0 0 24 24"
                             width="15">

                            <rect fill="currentColor"
                                  height="12"
                                  rx="2"
                                  width="12"
                                  x="6"
                                  y="6" />

                        </svg>

                    </button>
                </span>
                break;
        }
    </div>
</div>

@code {
    /// <summary>The pull request and its latest review.</summary>
    [Parameter, EditorRequired]
    public PullRequestListItem Item { get; set; } = default!;

    /// <summary>Why the last start attempt was refused, shown under the metadata; null for none.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>True while a start request for this row is in flight; disables the button.</summary>
    [Parameter]
    public bool IsStarting { get; set; }

    /// <summary>Raised by "Start review" and "Retry".</summary>
    [Parameter]
    public EventCallback OnStart { get; set; }

    /// <summary>Raised by "Review again", which the page confirms before starting a new review.</summary>
    [Parameter]
    public EventCallback OnReviewAgain { get; set; }

    /// <summary>True while a cancel request for this row is in flight; disables the stop button.</summary>
    [Parameter]
    public bool IsCancelling { get; set; }

    /// <summary>Raised by the stop button, which the page confirms before cancelling the review.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private RenderFragment ReviewAgainButton =>
        @<button @onclick="OnReviewAgain"
                 aria-label="Review again"
                 class="icon-btn pr-icon-btn"
                 disabled="@IsStarting"
                 title="Review again"
                 type="button">

            <svg aria-hidden="true"
                 fill="none"
                 height="17"
                 stroke="currentColor"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 stroke-width="1.75"
                 viewBox="0 0 24 24"
                 width="17">

                <path d="M21 7v6h-6" />
                <path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7" />

            </svg>

        </button>;

    private string StatusText => Item switch
    {
        { State: ReviewState.Queued } => "Queued",
        { State: ReviewState.PreparingWorktree } => "Preparing worktree…",
        { CurrentStepNumber: { } number } => $"Reviewing… step {number} of {Item.FlowSteps.Count}",
        _ => "Reviewing…",
    };

    private static string Plural(int count, string noun) => count == 1 ? $"1 {noun}" : $"{count} {noun}s";
}
