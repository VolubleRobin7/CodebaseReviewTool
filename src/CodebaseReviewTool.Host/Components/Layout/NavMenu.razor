@inject IJSRuntime JS

<div class="app-header-inner">
    <a class="brand"
       href="">

        <span class="brand-mark" />
        <span>Codebase Review Tool</span>

    </a>

    <nav class="app-nav">
        <NavLink Match="NavLinkMatch.All"
                 href="">

            Pull requests

        </NavLink>
    </nav>
    <div class="header-actions">
        <button @onclick="ToggleThemeAsync"
                aria-label="Switch theme"
                class="icon-btn"
                title="Switch theme"
                type="button">

            <svg class="icon-moon"
                 fill="none"
                 height="18"
                 stroke="currentColor"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 stroke-width="1.75"
                 viewBox="0 0 24 24"
                 width="18">

                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />

            </svg>

            <svg class="icon-sun"
                 fill="none"
                 height="18"
                 stroke="currentColor"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 stroke-width="1.75"
                 viewBox="0 0 24 24"
                 width="18">

                <circle cx="12"
                        cy="12"
                        r="4" />

                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />

            </svg>

        </button>

        <NavLink aria-label="Configuration"
                 class="icon-btn"
                 href="configuration"
                 title="Configuration">

            <svg fill="none"
                 height="18"
                 stroke="currentColor"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 stroke-width="1.75"
                 viewBox="0 0 24 24"
                 width="18">

                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />

                <circle cx="12"
                        cy="12"
                        r="3" />

            </svg>

        </NavLink>
    </div>
</div>

@code {
    private async Task ToggleThemeAsync()
    {
        // theme.js owns the attribute and localStorage; the icons follow it through CSS.
        await JS.InvokeAsync<string>("appTheme.toggle");
    }
}
