@using CodebaseReviewTool.Core.Configuration
@using CodebaseReviewTool.Core.Data
@using CodebaseReviewTool.Core.Data.Entities
@using CodebaseReviewTool.Core.DevOps
@using CodebaseReviewTool.Core.Git
@using CodebaseReviewTool.Core.Hosting
@using CodebaseReviewTool.Core.Processes
@using CodebaseReviewTool.Host.Components.Shared
@using CodebaseReviewTool.Host.Tray
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options

@rendermode InteractiveServer

@implements IDisposable

@inject IOptions<ClaudeOptions> ClaudeOptions
@inject IOptions<DatabaseOptions> DatabaseOptions
@inject IDbContextFactory<ReviewDbContext> DbContextFactory
@inject IDevOpsClient DevOpsClient
@inject IOptions<DevOpsOptions> DevOpsOptions
@inject IOptions<GitOptions> GitOptions
@inject NavigationManager NavigationManager
@inject GitRunner GitRunner
@inject IPollControl PollControl
@inject IProcessRunner ProcessRunner
@inject IRepositoryRegistry RepositoryRegistry
@inject IOptions<ReviewOptions> ReviewOptions
@inject StartupShortcut StartupShortcut
@inject IOptions<TrayOptions> TrayOptions

@page "/configuration"

<PageTitle>Configuration - Codebase Review Tool</PageTitle>

<div class="page-head">
    <div class="page-head-text">
        <h1 class="page-title">Review configuration</h1>
        <p class="page-lede">The review prompts, the environment the tool runs against and how it behaves on this machine.</p>
    </div>
</div>

<div aria-label="Configuration sections"
     class="tabs"
     role="tablist">
    @foreach (var tab in _tabs)
    {
        <button @onclick="() => SelectTab(tab.Key)"
                aria-controls="@PanelId(tab.Key)"
                aria-selected="@(tab.Key == _activeTab ? "true" : "false")"
                class="@(tab.Key == _activeTab ? "active tab" : "tab")"
                id="@TabId(tab.Key)"
                role="tab"
                type="button">

            @tab.Label

        </button>
    }
</div>

<NavigationLock ConfirmExternalNavigation="IsDirty"
                OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (_pendingTab is not null || _pendingUrl is not null)
{
    var leavingPage = _pendingUrl is not null;

    <Modal OnClose="StayOnSteps"
           Title="Unsaved changes">

        <ChildContent>
            <p class="modal-text">
                You have unsaved changes to the flow steps.
                @(leavingPage
                    ? "Leaving this page without saving loses them."
                    : "They are kept while you look at another tab, but reviews keep using the saved prompts until you save.")
            </p>

            @if (!IsValid)
            {
                <p class="modal-text step-invalid">A step is not valid, so the changes cannot be saved until you fix it.</p>
            }
        </ChildContent>

        <Footer>
            <button @onclick="StayOnSteps"
                    class="btn btn-secondary"
                    type="button">

                Stay

            </button>

            <button @onclick="ContinueWithoutSaving"
                    class="btn btn-secondary"
                    disabled="@_saving"
                    type="button">

                @(leavingPage ? "Leave without saving" : "Switch without saving")

            </button>

            <button @onclick="SaveAndContinueAsync"
                    class="btn btn-primary"
                    disabled="@(!IsValid || _saving)"
                    type="button">

                @(leavingPage ? "Save and leave" : "Save and switch")

            </button>
        </Footer>

    </Modal>
}

<div aria-labelledby="@TabId(ConfigurationTab.Steps)"
     class="tab-panel"
     hidden="@(_activeTab != ConfigurationTab.Steps)"
     id="@PanelId(ConfigurationTab.Steps)"
     role="tabpanel">

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Flow steps</h2>

            <div class="page-actions">
                <button @onclick="DiscardAsync"
                        class="btn btn-secondary"
                        disabled="@(!IsDirty || _saving)"
                        type="button">

                    Discard

                </button>

                <button @onclick="SaveAsync"
                        class="btn btn-primary"
                        disabled="@(!IsDirty || !IsValid || _saving)"
                        type="button">

                    @(IsDirty ? "Save changes" : "Saved")

                </button>
            </div>
        </div>

        <p class="section-note">These prompts run in order for every review. Each step produces one section of the report. Changes apply to reviews started after you save.</p>

        @if (_saveError is not null)
        {
            <p class="step-invalid">@_saveError</p>
        }

        @if (_drafts.Count == 0)
        {
            <p class="empty">The flow has no steps.</p>
        }
        else
        {
            <ol class="step-rail">
                @for (var i = 0; i < _drafts.Count; i++)
                {
                    <StepEditor @key="_drafts[i].Step"
                                DefaultModel="@ClaudeOptions.Value.DefaultModel"
                                DefaultTimeoutMinutes="@ClaudeOptions.Value.TimeoutMinutes"
                                Draft="_drafts[i]"
                                Index="i"
                                IsLast="@(i == _drafts.Count - 1)"
                                Models="ClaudeOptions.Value.Models"
                                OnChanged="StateHasChanged"
                                PullRequests="_pullRequests" />
                }
            </ol>
        }
    </section>

</div>

<div aria-labelledby="@TabId(ConfigurationTab.Environment)"
     class="tab-panel"
     hidden="@(_activeTab != ConfigurationTab.Environment)"
     id="@PanelId(ConfigurationTab.Environment)"
     role="tabpanel">

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Checks</h2>

            <button @onclick="RunAllChecksAsync"
                    class="btn btn-secondary"
                    disabled="@AnyRunning"
                    type="button">

                Run all checks

            </button>
        </div>
        <div class="rows">
            @foreach (var check in _checks)
            {
                <div class="row check-row">
                    <span>@check.Name</span>
                    <span>
                        @switch (check.State)
                        {
                            case CheckState.Running:
                                <span class="check-state check-running">Running…</span>
                                break;

                            case CheckState.Passed:
                                <span class="check-state check-passed">Passed</span>
                                break;

                            case CheckState.Failed:
                                <span class="check-state check-failed">Failed</span>
                                break;

                            default:
                                <span class="faint">Not run</span>
                                break;
                        }

                        @if (!string.IsNullOrEmpty(check.Detail))
                        {
                            <span class="row-detail">@check.Detail</span>
                        }
                    </span>
                    <span class="check-action">
                        <button @onclick="() => RunCheckAsync(check)"
                                class="btn btn-link"
                                disabled="@check.IsRunning"
                                type="button">

                            Check

                        </button>
                    </span>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Repositories</h2>
            <span class="count">@RepositoryRegistry.Repositories.Count</span>
        </div>
        <div class="rows">
            <div class="row-head repo-row">
                <span>Name</span>
                <span>Local path</span>
                <span>Remote</span>
                <span>Organisation / project / repository</span>
            </div>
            @foreach (var repository in RepositoryRegistry.Repositories)
            {
                <div class="row repo-row">
                    <span>
                        @repository.DisplayName
                        <span class="row-detail">@repository.Key</span>
                    </span>
                    <span class="mono">@repository.LocalPath</span>
                    <span>@repository.RemoteName</span>
                    <span>@repository.Organization / @repository.Project / @repository.Repository</span>
                </div>
            }
        </div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Worktrees</h2>

            <a class="btn btn-secondary"
               href="worktrees">

                Manage worktrees

            </a>
        </div>
        <p class="section-note">Created under <span class="mono">@GitOptions.Value.WorktreeRoot</span> and removed automatically @WorktreeCleanupText.Describe(GitOptions.Value).</p>
    </section>

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Environment</h2>
        </div>

        <p class="section-note">Read from appsettings.json and user-secrets; edit those files and restart to change it.</p>

        <dl class="kv">
            <dt>Database</dt>
            <dd class="mono">@DatabaseOptions.Value.Path</dd>

            <dt>Claude executable</dt>
            <dd class="mono">@ClaudeOptions.Value.ExecutablePath</dd>
            <dt>Claude default model</dt>
            <dd>@ClaudeOptions.Value.DefaultModel</dd>
            <dt>Claude timeout</dt>
            <dd>@ClaudeOptions.Value.TimeoutMinutes minutes</dd>
            <dt>Claude max turns</dt>
            <dd>@ClaudeOptions.Value.MaxTurns</dd>
            <dt>Claude usage refresh</dt>
            <dd>every @ClaudeOptions.Value.UsageRefreshMinutes minutes</dd>
            <dt>Claude allowed tools</dt>
            <dd class="mono">@string.Join("  ", ClaudeOptions.Value.AllowedTools)</dd>

            <dt>Git executable</dt>
            <dd class="mono">@GitOptions.Value.ExecutablePath</dd>
            <dt>Worktree root</dt>
            <dd class="mono">@GitOptions.Value.WorktreeRoot</dd>
            <dt>Worktree auto-cleanup (PR open)</dt>
            <dd>@WorktreeCleanupText.Days(GitOptions.Value.AutoCleanupAfterDays) after the review finishes</dd>
            <dt>Worktree auto-cleanup (PR closed)</dt>
            <dd>@WorktreeCleanupText.Days(GitOptions.Value.AutoCleanupAfterPullRequestClosedDays) after the PR is completed or abandoned</dd>
            <dt>Fetch before review</dt>
            <dd>@YesNo(GitOptions.Value.FetchBeforeReview)</dd>

            <dt>DevOps organisation URL</dt>
            <dd class="mono">@DevOpsOptions.Value.OrganizationUrl</dd>
            <dt>DevOps poll interval</dt>
            <dd>@DevOpsOptions.Value.PollIntervalSeconds seconds</dd>
            <dt>DevOps auth mode</dt>
            <dd>@DevOpsOptions.Value.AuthMode</dd>
            <dt>DevOps PAT</dt>
            <dd>@PatDescription</dd>
            <dt>DevOps API version</dt>
            <dd>@ApiVersionDescription</dd>

            <dt>Max concurrent reviews</dt>
            <dd>@ReviewOptions.Value.MaxConcurrent</dd>

            <dt>Tray enabled</dt>
            <dd>@YesNo(TrayOptions.Value.Enabled)</dd>
            <dt>Open browser on start</dt>
            <dd>@YesNo(TrayOptions.Value.OpenBrowserOnStart)</dd>
        </dl>
    </section>

</div>

<div aria-labelledby="@TabId(ConfigurationTab.System)"
     class="tab-panel"
     hidden="@(_activeTab != ConfigurationTab.System)"
     id="@PanelId(ConfigurationTab.System)"
     role="tabpanel">

    <section class="section">
        <div class="section-head">
            <h2 class="section-title">Tray</h2>
        </div>
        <p class="section-note">The tray icon opens this UI, shows how many reviews are running and announces each one that finishes.</p>

        @if (_trayError is not null)
        {
            <p class="step-invalid">@_trayError</p>
        }

        <div class="rows">
            <div class="row check-row">
                <span>Run at login</span>

                <span>
                    <span class="@(_runAtLogin ? "check-passed check-state" : "check-state faint")">@(_runAtLogin ? "On" : "Off")</span>
                    <span class="row-detail">@StartupShortcut.ShortcutPath</span>
                </span>

                <span class="check-action">
                    <button @onclick="ToggleRunAtLoginAsync"
                            class="btn btn-link"
                            disabled="@_changingRunAtLogin"
                            type="button">

                        @(_runAtLogin ? "Turn off" : "Turn on")

                    </button>
                </span>
            </div>

            <div class="row check-row">
                <span>DevOps polling</span>

                <span>
                    <span class="@(PollControl.IsPaused ? "check-running check-state" : "check-passed check-state")">@(PollControl.IsPaused ? "Paused" : "Running")</span>
                    <span class="row-detail">While paused only a manual refresh of the pull request list polls. Resets on restart.</span>
                </span>

                <span class="check-action">
                    <button @onclick="() => PollControl.SetPaused(!PollControl.IsPaused)"
                            class="btn btn-link"
                            type="button">

                        @(PollControl.IsPaused ? "Resume" : "Pause")

                    </button>
                </span>

            </div>
        </div>
    </section>

</div>

@code {
    private static readonly TimeSpan _checkTimeout = TimeSpan.FromSeconds(60);

    private static readonly IReadOnlyList<(ConfigurationTab Key, string Label)> _tabs =
    [
        (ConfigurationTab.Steps, "Steps"),
        (ConfigurationTab.Environment, "Environment"),
        (ConfigurationTab.System, "System"),
    ];

    private readonly List<Check> _checks = [];

    // Every panel stays rendered and only the active one is shown, so switching tabs keeps unsaved step edits, each
    // step editor's own state and any checks still running.
    private ConfigurationTab _activeTab = ConfigurationTab.Steps;

    // Where the user was going when the unsaved-changes dialog stopped them: another tab, or another page.
    private ConfigurationTab? _pendingTab;
    private string? _pendingUrl;

    // Set just before re-issuing a navigation the user has confirmed, so the lock lets it through.
    private bool _navigationConfirmed;

    private List<FlowStepDraft> _drafts = [];
    private List<PullRequest> _pullRequests = [];
    private bool _saving;
    private string? _saveError;
    private bool _runAtLogin;
    private bool _changingRunAtLogin;
    private string? _trayError;

    private bool AnyRunning => _checks.Any(c => c.IsRunning);

    private bool IsDirty => _drafts.Any(d => d.IsEdited);

    private bool IsValid => _drafts.All(d => d.IsValid);

    private string PatDescription => string.IsNullOrEmpty(DevOpsOptions.Value.Pat)
        ? "not set"
        : $"set ({DevOpsOptions.Value.Pat.Length} characters)" + (DevOpsOptions.Value.UseDefaultCredentials ? ", not used (Windows auth)" : string.Empty);

    // Filled in by the DevOps check, which probes the version before calling who-am-I.
    private DevOpsApiVersionResult? _apiVersion;

    private string ApiVersionDescription => _apiVersion switch
    {
        { Succeeded: true } v => $"{v.Version} ({(v.IsDetected ? "detected" : "configured")})",
        { Succeeded: false } => "unknown (DevOps check failed)",
        null when !string.IsNullOrWhiteSpace(DevOpsOptions.Value.ApiVersion) => $"{DevOpsOptions.Value.ApiVersion} (configured)",
        null => "auto-detect (run the DevOps check)",
    };

    protected override async Task OnInitializedAsync()
    {
        _runAtLogin = StartupShortcut.IsEnabled;
        PollControl.Changed += OnPollChanged;

        _checks.Add(new Check("Claude", CheckClaudeAsync));
        _checks.Add(new Check("git", CheckGitAsync));
        _checks.Add(new Check("DevOps", CheckDevOpsAsync));
        foreach (var repository in RepositoryRegistry.Repositories)
        {
            _checks.Add(new Check($"Repository: {repository.DisplayName}", () => CheckRepositoryAsync(repository)));
        }

        await LoadStepsAsync();
    }

    private async Task LoadStepsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();

        var steps = await db.FlowSteps.AsNoTracking().OrderBy(s => s.Step).ToListAsync();
        _drafts = [.. steps.Select(s => new FlowStepDraft(s))];

        var keys = RepositoryRegistry.Repositories.Select(r => r.Key).ToList();
        _pullRequests = await db.PullRequests
            .AsNoTracking()
            .Where(p => p.IsOpen && keys.Contains(p.RepositoryKey))
            .OrderByDescending(p => p.Id)
            .ToListAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving || !IsDirty || !IsValid)
        {
            return;
        }

        _saving = true;
        _saveError = null;
        try
        {
            // One SaveChanges is one transaction, so either every changed step is written or none is. Nothing is
            // published: a review reads the flow when it starts.
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var edited = _drafts.Where(d => d.IsEdited).ToList();
            var stepNumbers = edited.Select(d => d.Step).ToList();
            var rows = await db.FlowSteps.Where(s => stepNumbers.Contains(s.Step)).ToDictionaryAsync(s => s.Step);

            var now = DateTime.UtcNow;
            foreach (var draft in edited)
            {
                if (rows.TryGetValue(draft.Step, out var row))
                {
                    draft.ApplyTo(row);
                    row.UpdatedAt = now;
                }
            }

            await db.SaveChangesAsync();
            edited.ForEach(d => d.MarkSaved());
        }
        catch (Exception ex)
        {
            _saveError = $"Saving failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose() => PollControl.Changed -= OnPollChanged;

    // The tray menu can pause polling too; the event arrives on its thread.
    private void OnPollChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleRunAtLoginAsync()
    {
        if (_changingRunAtLogin)
        {
            return;
        }

        _changingRunAtLogin = true;
        _trayError = null;
        try
        {
            var enable = !_runAtLogin;
            await Task.Run(() => StartupShortcut.SetEnabled(enable));
        }
        catch (Exception ex)
        {
            _trayError = $"Changing run at login failed: {ex.Message}";
        }
        finally
        {
            _runAtLogin = StartupShortcut.IsEnabled;
            _changingRunAtLogin = false;
        }
    }

    private async Task DiscardAsync()
    {
        _saveError = null;
        await LoadStepsAsync();
    }

    private void SelectTab(ConfigurationTab tab)
    {
        if (tab == _activeTab)
        {
            return;
        }

        // Only leaving the Steps tab asks: once the user has chosen to switch, the edits stay put and moving between
        // the other tabs, or back to Steps, does not ask again.
        if (_activeTab == ConfigurationTab.Steps && IsDirty)
        {
            _pendingTab = tab;
            return;
        }

        _activeTab = tab;
    }

    private void OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (_navigationConfirmed || !IsDirty)
        {
            return;
        }

        context.PreventNavigation();
        _pendingTab = null;
        _pendingUrl = context.TargetLocation;
    }

    private void StayOnSteps()
    {
        _pendingTab = null;
        _pendingUrl = null;
        _activeTab = ConfigurationTab.Steps;
    }

    private void ContinueWithoutSaving()
    {
        if (_pendingUrl is not null)
        {
            // Leaving the page throws the drafts away with the component, so there is nothing to discard here.
            LeaveTo(_pendingUrl);
            return;
        }

        if (_pendingTab is { } tab)
        {
            _activeTab = tab;
        }

        _pendingTab = null;
    }

    private async Task SaveAndContinueAsync()
    {
        await SaveAsync();

        if (_saveError is not null)
        {
            // Saving failed: stay on Steps, where the error shows beside the steps that were not saved.
            StayOnSteps();
            return;
        }

        ContinueWithoutSaving();
    }

    private void LeaveTo(string url)
    {
        _pendingUrl = null;
        _navigationConfirmed = true;
        NavigationManager.NavigateTo(url);
    }

    private async Task RunAllChecksAsync()
    {
        // Run concurrently; each check updates its own row as it finishes.
        await Task.WhenAll(_checks.Select(RunCheckAsync));
    }

    private async Task RunCheckAsync(Check check)
    {
        if (check.IsRunning)
        {
            return;
        }

        check.State = CheckState.Running;
        check.Detail = null;
        StateHasChanged();

        try
        {
            var (passed, detail) = await check.Run();
            check.State = passed ? CheckState.Passed : CheckState.Failed;
            check.Detail = detail;
        }
        catch (Exception ex)
        {
            check.State = CheckState.Failed;
            check.Detail = $"{ex.GetType().Name}: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task<(bool Passed, string Detail)> CheckClaudeAsync()
    {
        var request = new ProcessRequest(ClaudeOptions.Value.ExecutablePath, ["--version"], Timeout: _checkTimeout);
        var result = await ProcessRunner.RunAsync(request);
        return Describe(result);
    }

    private async Task<(bool Passed, string Detail)> CheckGitAsync()
    {
        var result = await GitRunner.RunAsync(null, ["--version"], _checkTimeout);
        return Describe(result);
    }

    private async Task<(bool Passed, string Detail)> CheckDevOpsAsync()
    {
        _apiVersion = await DevOpsClient.GetApiVersionAsync();
        if (!_apiVersion.Succeeded)
        {
            return (false, _apiVersion.Error ?? "Unknown error");
        }

        var result = await DevOpsClient.GetCurrentUserAsync();
        return result.Succeeded
            ? (true, $"Authenticated as {result.DisplayName} ({DevOpsOptions.Value.AuthMode}); API version {ApiVersionDescription}")
            : (false, result.Error ?? "Unknown error");
    }

    private async Task<(bool Passed, string Detail)> CheckRepositoryAsync(ResolvedRepository repository)
    {
        var result = await GitRunner.RunAsync(repository.LocalPath, ["rev-parse", "--is-inside-work-tree"], _checkTimeout);
        if (result.Succeeded && result.StandardOutput.Trim() == "true")
        {
            return (true, $"Git work tree; remote {repository.RemoteName}: {repository.RemoteUrl}");
        }

        var (_, detail) = Describe(result);
        return (false, $"{repository.LocalPath} is not a git work tree. {detail}");
    }

    private static (bool Passed, string Detail) Describe(ProcessResult result)
    {
        if (result.TimedOut)
        {
            return (false, $"Timed out after {result.Duration.TotalSeconds:0} s");
        }

        if (result.ExitCode != 0)
        {
            var error = string.IsNullOrWhiteSpace(result.StandardError) ? result.StandardOutput : result.StandardError;
            return (false, $"Exit code {result.ExitCode}: {error.Trim()}");
        }

        return (true, result.StandardOutput.Trim());
    }

    private static string YesNo(bool value) => value ? "Yes" : "No";

    private static string TabId(ConfigurationTab tab) => $"config-tab-{tab.ToString().ToLowerInvariant()}";

    private static string PanelId(ConfigurationTab tab) => $"config-panel-{tab.ToString().ToLowerInvariant()}";

    private enum ConfigurationTab
    {
        Steps,
        Environment,
        System,
    }

    private enum CheckState
    {
        NotRun,
        Running,
        Passed,
        Failed,
    }

    private sealed class Check(string name, Func<Task<(bool Passed, string Detail)>> run)
    {
        public string Name { get; } = name;

        public Func<Task<(bool Passed, string Detail)>> Run { get; } = run;

        public CheckState State { get; set; }

        public string? Detail { get; set; }

        public bool IsRunning => State == CheckState.Running;
    }
}
