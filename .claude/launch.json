{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "host",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/CodebaseReviewTool.Host"],
      "port": 5211
    },
    {
      "name": "tray",
      "runtimeExecutable": "src/CodebaseReviewTool.Host/bin/Debug/net10.0-windows/CodebaseReviewTool.Host.exe",
      "runtimeArgs": ["--Database:Path=%LOCALAPPDATA%\\CodebaseReviewTool-DEV\\reviews.db", "--Kestrel:Endpoints:Http:Url=http://localhost:5211"],
      "port": 5211
    }
  ]
}
